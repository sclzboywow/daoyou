{
  "name": "wanjiedaoyou",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0",
  "type": "module",
  "scripts": {
    "auth:generate": "bunx drizzle-kit generate --config drizzle.auth.config.ts",
    "auth:info": "bunx --bun auth@latest info --config src/server/lib/auth/auth.ts --json",
    "auth:migrate": "bunx drizzle-kit migrate --config drizzle.auth.config.ts",
    "build": "bun run build:client && bun run build:server",
    "build:client": "tsc -b tsconfig.app.json && vite build --mode client",
    "build:production": "bash scripts/build-production-release.sh",
    "build:server": "tsc -b tsconfig.node.json && vite build --mode server",
    "dev": "bun run --parallel dev:api dev:web",
    "dev:api": "bun run --watch src/index.ts",
    "dev:web": "vite",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/alibaba": "^2.0.16",
    "@ai-sdk/deepseek": "^3.0.17",
    "@better-auth/drizzle-adapter": "^1.6.25",
    "@better-auth/i18n": "^1.6.25",
    "@marsidev/react-turnstile": "^1.5.4",
    "@microfleet/ioredis-lock": "^6.0.1",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "ai": "^7.0.44",
    "better-auth": "^1.6.25",
    "bullmq": "^5.81.3",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-format": "^3.1.2",
    "drizzle-orm": "^0.45.2",
    "hono": "4.12.32",
    "ioredis": "^5.11.1",
    "jsonrepair": "^3.15.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "phaser": "^4.0.0",
    "phaser4-rex-plugins": "4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "^8.3.0",
    "react-zoom-pan-pinch": "^4.0.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hono/vite-build": "1.11.1",
    "@types/bun": "1.3.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/d3-format": "^3.0.4",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
